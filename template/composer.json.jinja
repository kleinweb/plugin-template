{
  "name": "kleinweb/{{ prj_repo_name }}",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "description": "The website source code for {{ prj_title }}",
  "homepage": "https://{{ prj_domain }}/",
  "authors": [
    {
      "name": "Chris Montgomery",
      "email": "chrismont@temple.edu",
      "homepage": "https://github.com/astratagem"
    }
  ],
  "support": {
    "issues": "https://github.com/kleinweb/{{ prj_repo_name }}/issues"
  },
  "repositories": [
    {
      "name": "wp-packages",
      "type": "composer",
      "url": "https://repo.wp-packages.org"
    }
  ],
  "require": {
    "php": ">=8.3",
    "kleinweb/lib": "^2",
    "php-di/php-di": "^7.0"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "codeception/codeception": "^5.0",
    "codeception/module-asserts": "^3.0",
    "codeception/module-db": "^3.0",
    "friendsofphp/php-cs-fixer": "^3.59",
    "kleinweb/php-coding-standards": "^0.8.0",
    "lucatume/wp-browser": "^4.0",
    "phpstan/extension-installer": "^1.3",
    "phpstan/phpstan": "^1.10",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpunit/phpunit": "^10.5",
    "roave/security-advisories": "dev-latest",
    "slevomat/coding-standard": "^8.15",
    "squizlabs/php_codesniffer": "^3.7.1",
    "szepeviktor/phpstan-wordpress": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "{{ prj_namespace }}\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "{{ prj_namespace }}\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "optimize-autoloader": true,
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "wp-content/mu-plugins/{$name}/": ["type:wordpress-muplugin"],
      "wp-content/plugins/{$name}/": ["type:wordpress-plugin"],
      "wp-content/themes/{$name}/": ["type:wordpress-theme"]
    }
  },
  "scripts": {
    "check-syntax": "parallel-lint --show-deprecated --exclude .git --exclude .cache --exclude .data --exclude .direnv --exclude node_modules --exclude vendor .",
    "php-cs-fixer": "php-cs-fixer",
    "phpcbf": "phpcbf --extensions=php --standard=$PRJ_ROOT/.phpcs.xml.dist",
    "phpcs": "phpcs --extensions=php --standard=$PRJ_ROOT/.phpcs.xml.dist",
    "phpstan": "phpstan analyse --memory-limit 2G",
    "check": ["@check-syntax", "@php-cs-fixer check", "@phpcs", "@phpstan"],
    "lint": ["@check-syntax", "@phpcs", "@phpstan"],
    "fix": ["@php-cs-fixer fix", "@phpcbf"]
  }
}
